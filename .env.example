# Docker Compose — host publish + shared Postgres network
APP_PUBLISH_PORT=4040

# Required for `docker compose up`: Docker network that circolife-ai-postgres is on.
# Discover: docker inspect circolife-ai-postgres -f '{{range $k,$v := .NetworkSettings.Networks}}{{$k}}{{end}}'
POSTGRES_DOCKER_NETWORK=

# Only used with: docker compose --profile local up -d
POSTGRES_PASSWORD=circomap
POSTGRES_PUBLISH_PORT=5432

# App secrets and integrations: copy server/.env.example → server/.env
# Production / shared Postgres example DATABASE_URL:
#   postgres://circomap:<password>@circolife-ai-postgres:5432/circomap
# Required:
#   APP_PASSWORD=...          # also seeds the first admin password
#   BOOTSTRAP_ADMIN_EMAIL=... # optional; or claim first admin by signing in with email + APP_PASSWORD
#   SESSION_SECRET=...
#   GOOGLE_MAPS_API_KEY=...
#   Zoho credentials (for sync)
#   NODE_ENV=production
