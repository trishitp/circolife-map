# Local: localhost. Shared-Postgres Docker: hostname = container name on the
# same network (e.g. circolife-ai-postgres). Local compose profile: host `db`.
# Set DATABASE_SSL=true for most managed Postgres (Neon, RDS, etc.)
DATABASE_URL=postgres://circomap:CHANGE_ME@circolife-ai-postgres:5432/circomap
DATABASE_SSL=
PORT=4000
# development | production (required non-empty APP_PASSWORD when production)
NODE_ENV=production

# Comma-separated browser origins in production (e.g. https://maps.yourdomain.com)
CORS_ORIGINS=
# Absolute path to built SPA (optional; auto-detects ../web/dist; Docker sets WEB_DIST)
WEB_DIST=

ZOHO_ACCOUNTS_BASE=https://accounts.zoho.in
ZOHO_ANALYTICS_BASE=https://analyticsapi.zoho.in
ZOHO_CLIENT_ID=
ZOHO_CLIENT_SECRET=
ZOHO_REFRESH_TOKEN=
# Optional — only for web OAuth apps. Leave blank for Zoho Self Client (Analytics sync).
ZOHO_REDIRECT_URI=
# Maps user login (Sign in with Zoho). Required to enable Zoho sign-in.
# Must be listed on a Server-based client (not Self Client) in Zoho API Console.
ZOHO_LOGIN_REDIRECT_URI=https://maps.circolife.org/api/auth/zoho/callback
# Optional separate Server-based client if Analytics uses a Self Client
# ZOHO_LOGIN_CLIENT_ID=
# ZOHO_LOGIN_CLIENT_SECRET=
ZOHO_ORG_ID=60041938002
ZOHO_WORKSPACE_ID=441267000002068095
ZOHO_FSM_WORKSPACE_ID=441267000003723011

GEOCODER=google
OLAMAPS_API_KEY=
# Geocoding + Map Tiles + Directions (restrict key by HTTP referrer / IP in GCP)
GOOGLE_MAPS_API_KEY=

# Optional USD list prices per 1,000 calls (Admin can also edit a saved rate card)
# USD_INR=87
# PRICE_GEOCODING_PER_1K=5
# PRICE_ROUTES_PER_1K=10
# PRICE_DIRECTIONS_PER_1K=5
# PRICE_MAPS_JS_LOAD_PER_1K=7

# Required in production (NODE_ENV=production will refuse empty APP_PASSWORD)
# This is not a user login — people sign in with Zoho.
APP_PASSWORD=
# Optional: comma-separated emails that always stay admin
ADMIN_EMAILS=
# Optional HMAC secret for session tokens (defaults to APP_PASSWORD)
SESSION_SECRET=
# Optional secret for scripts — send header X-Admin-Token instead of a user session
ADMIN_TOKEN=

TRUTH_ENGINE_URL=
TRUTH_ENGINE_TOKEN=
