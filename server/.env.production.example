# Production / server Docker — copy to server/.env on the host (or merge keys).
# Hostname circolife-ai-postgres requires POSTGRES_DOCKER_NETWORK = that container's network.
#
# DATABASE_URL=postgres://circomap:<password>@circolife-ai-postgres:5432/circomap
# DATABASE_SSL=
# PORT=4000
# NODE_ENV=production
# CORS_ORIGINS=https://maps.yourdomain.com
# WEB_DIST=
#
# ZOHO_ACCOUNTS_BASE=https://accounts.zoho.in
# ZOHO_ANALYTICS_BASE=https://analyticsapi.zoho.in
# ZOHO_CLIENT_ID=
# ZOHO_CLIENT_SECRET=
# ZOHO_REFRESH_TOKEN=
# ZOHO_REDIRECT_URI=
# ZOHO_ORG_ID=60041938002
# ZOHO_WORKSPACE_ID=441267000002068095
# ZOHO_FSM_WORKSPACE_ID=441267000003723011
#
# GEOCODER=google
# OLAMAPS_API_KEY=
# GOOGLE_MAPS_API_KEY=
#
# APP_PASSWORD=
# SESSION_SECRET=
# ADMIN_TOKEN=
#
# See server/.env.example for the full uncommented template.
